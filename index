olute;bottom:9px;left:9px;border:0;border-radius:50%;background:#211f1ebd;width:34px;height:34px}.moon{position:absolute;bottom:9px;right:9px;border:0;border-radius:50%;background:#211f1ebd;width:34px;height:34px}.bottomnav{position:absolute;bottom:28px;left:50%;transform:translateX(-50%);border-radius:50px;background:#ffffff20;display:flex;gap:6px;padding:9px;backdrop-filter:blur(12px)}.bottomnav button{border:0;background:transparent;border-radius:50%;width:38px;height:38px}.bottomnav button:hover,.bottomnav button.on{background:#ffffff33}.bottom-sheet{position:absolute;bottom:0;left:0;right:0;padding:34px 24px 34px;background:linear-gradient(0deg,#080808 85%,#080808e8);border-radius:25px 25px 0 0}.bottom-sheet h2{font-size:30px;line-height:1.02;font-weight:400;margin:6px 0 10px}.bottom-sheet p{font-size:12px;line-height:1.55;color:#bbb8b3;max-width:310px}.actions{display:flex;gap:10px;margin-top:24px}.actions button{flex:1;padding:12px 7px;border:1px solid #ffffff35;border-radius:50px;background:#ffffff1a;font-size:12px;transition:.2s}.actions button:hover{background:#f0ebe2;color:#111}.back{position:absolute;top:55px;left:23px;z-index:9}.logo{position:absolute;top:14%;left:50%;transform:translateX(-50%);font-size:29px;color:#f4efe7b5}.modal{position:absolute;inset:0;background:#0009;z-index:30;display:none;align-items:center;justify-content:center;padding:25px}.modal.show{display:flex}.dialog{background:#eee9df;color:#24221e;border-radius:22px;padding:26px;width:100%;max-width:310px;text-align:center}.dialog h3{margin:0 0 12px}.dialog p{font-size:13px;line-height:1.6}.dialog button{background:#24221e;color:white;border:0;border-radius:50px;padding:12px 35px;margin-top:10px}.toast{position:absolute;bottom:110px;left:50%;transform:translateX(-50%);background:#f2eee5;color:#222;border-radius:20px;padding:10px 18px;font-size:12px;z-index:40;opacity:0;pointer-events:none;transition:.3s;white-space:nowrap}.toast.show{opacity:1}.fadeup{animation:up .7s both}.delay{anim