</style></head><body><main class="shell" aria-label="Travel mobile website demo"><section class="screen one active" id="home"><div class="photo"></div><div class="status"><span>13:13</span><span>▴ ▰ ▰</span></div><div class="island"></div><div class="brand">◉</div><div class="intro fadeup"><h1>Unveil the<br>Travel Wonders</h1><div class="eyebrow">N O R W A Y</div><p>Take the first step into an unforgettable journey.</p><button class="pill" data-go="explore">Discover More</button><div class="tiny">By joining us, you agree to our terms &amp; conditions.</div></div></section><section class="screen two" id="explore"><div class="status"><span>13:13</span><span>▴ ▰ ▰</span></div><div class="island"></div><header class="head"><button class="round" data-go="home" aria-label="Back to home">‹</button><div class="place">Reykjavik<small>(Country · Iceland)</small></div><button class="round" data-action="share" aria-label="Share">↗</button></header><div class="stack"><div class="layer"></div><div class="layer"></div></div><article class="card-main"><div style="display:flex;justify-content:space-between"><span style="font-size:10px">✦ FEATURED JOURNEY</span><button class="round" data-action="location" aria-label="Location">⌖</button></div><h2>Magic<br>Dreamland</h2><div class="date">N O V E M B E R</div><div class="landscape"><button class="play" data-action="video" aria-label="Play video">▶</button><button class="moon" data-action="save" aria-label="Save">☾</button></div></article><nav class="bottomnav" aria-label="Main navigation"><button class="on" data-action="explore" aria-label="Explore">◉</button><button data-go="detail" aria-label="Places">◐</button><button data-action="save" aria-label="Saved">◈</button><button data-action="info" aria-label="Info">?</button></nav></section><section class="screen three" id="detail"><div class="photo"></div><div class="status"><span>13:13</span><span>▴ ▰ ▰</span></div><div class="island"></div><button class="round back" data-go="explore" aria-label="Back">‹</button><div class="logo">◉</div><div class="bottom-sheet"><h2>Places With<br>Stories.</h2><div class="eyebrow">W R O C Ł A W</div><p>Every place has a story. Uncover yours in the most picturesque locations around the world. Chart your course through new adventures.</p><div class="actions"><button data-action="buy">Buy · $1,290.00</button><button data-action="reserve">Reserve</button></div></div></section><div class="modal" id="modal"><div class="dialog"><h3 id="modal-title">Demo</h3><p id="modal-text"></p><button id="close">Close</button></div></div><div class="toast" id="toast"></div></main><script>
const screens=[...document.querySelectorAll('.screen')];const modal=document.getElementById('modal');const toast=document.getElementById('toast');let timer;function go(id){screens.forEach(s=>s.classList.toggle('active',s.id===id));history.replaceState(null,'','#'+id)}function notice(t){toast.textContent=t;toast.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>toast.classList.remove('show'),1900)}function dialog(title,message){document.getElementById('modal-title').textContent=title;document.getElementById('modal-text').textContent=message;modal.classList.add('show')}document.addEventListener('click',e=>{const b=e.target.closest('[data-go],[data-action]');if(!b)return;if(b.dataset.go){go(b.dataset.go);return}switch(b.dataset.action){case 'explore':go('explore');break;case 'buy':dialog('Purchase demo','This is a UI prototype. No payment will be processed.');break;case 'reserve':dialog('Reservation demo','This is a UI prototype. No reservation will be submitted.');break;case 'video':dialog('Showreel','Video content was not provided, so this area is intentionally left as a placeholder.');break;case 'save':notice('Saved for later ♡');break;case 'location':notice('Reykjavik, Iceland');break;case 'share':notice('Sharing is a demo placeholder');break;case 'info':dialog('About this demo','A responsive mobile web prototype reconstructed from a reference image.');break;}});document.getElementById('close').onclick=()=>modal.classList.remove('show');modal.onclick=e=>{if(e.target===modal)modal.classList.remove('show')};document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(modal.classList.contains('show'))modal.classList.remove('show');else go('home')}});if(['home','explore','detail'].includes(location.hash.slice(1)))go(location.hash.slice(1));
